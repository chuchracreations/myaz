{
  "name": "coders-canvas",
  "displayName": "Coders Canvas",
  "description": "Modular productivity assistant for VS Code starting with rich Snippets management.",
  "version": "0.1.0",
  "publisher": "himanshuchuchra",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/himanshuchuchra/coders-canvas"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:coders-canvas.sidebarView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coders-canvas-container",
          "title": "Coders Canvas",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "coders-canvas-container": [
        {
          "type": "webview",
          "id": "coders-canvas.sidebarView",
          "name": ""
        }
      ]
    },
    "commands": [
      {
        "command": "coders-canvas.snippets.createFromSelection",
        "title": "Coders Canvas: Save Selection as Snippet",
        "icon": "$(add)"
      },
      {
        "command": "coders-canvas.snippets.insert",
        "title": "Coders Canvas: Insert Snippet",
        "icon": "$(insert)"
      },
      {
        "command": "coders-canvas.openStorageFile",
        "title": "Coders Canvas: Open Workspace Data File",
        "icon": "$(folder-opened)"
      },
      {
        "command": "coders-canvas.exportData",
        "title": "Coders Canvas: Export Workspace Data",
        "icon": "$(cloud-download)"
      },
      {
        "command": "coders-canvas.importData",
        "title": "Coders Canvas: Import Workspace Data",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "coders-canvas.refresh",
        "title": "Coders Canvas: Refresh View",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "coders-canvas.snippets.createFromSelection",
          "when": "editorHasSelection",
          "group": "coders-canvas@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "npx @vscode/vsce package --no-rewrite-relative-links",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.3"
  }
}